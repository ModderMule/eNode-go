# eNode-go config for the interop rig. Rendered by entrypoint.enode.sh, which fills
# __SELF_IP__ / __SELF_IP6__ from the container's own interfaces and __SEEDS__ / __NAME__
# / __IPFILTER_ENABLED__ from the environment. Not a template for real deployments: the
# intervals here are far shorter than any public server should use.

name: "__NAME__"
description: "eNode-go interop node (tests/interop)"

# Bind the dual-stack wildcard; advertise the container's own address. Deliberately NOT
# dynIp: "auto" — that resolves over the public internet and would advertise the Docker
# host's WAN address, which no peer on this network can reach.
address: ""
dynIp: "__SELF_IP__"
# Emptied so nothing in this image can ever reach out to the internet: with dynIp set to a
# literal these are unused, and an empty list makes that structural rather than incidental.
testUrls: []

messageLowID: "You have LowID."
messageLogin: "Welcome to the eNode-go interop node!"

# Peers come from gossip, never from a static list — that is the point of the exercise.
servers: []

noAssert: false
logLevel: "debug"
# Logs go to stdout so `docker logs` is the single place the test reads evidence from.
logFile: ""

supportCrypt: true
requestCrypt: true
requireCrypt: true
auxiliarPort: false
IPinLogin: false

tcp:
  port: 5555
  portObfuscated: 5565
  maxConnections: 1000
  connectionTimeout: 2000
  disconnectTimeout: 3600
  allowLowIDs: true
  minLowID: 1
  maxLowID: 16777215

udp:
  port: 5559
  portObfuscated: 5567   # tcp.port + 12, where eMule's first crypt-ping always lands
  # Shares the socket above. tcp.port+12 is required, not preferred: eserver reads a peer's
  # TCP port as this value minus 12, so anything else files our frames against a phantom
  # server and we never reach its "working servers" list. See docs/server-gossip.md §8.
  portGossip: 5567
  getSources: true
  getFiles: true
  serverKey: 305419896

gossip:
  enabled: true
  seeds: __SEEDS__
  # 10s instead of 150s: a test that waited out the production cadence would take minutes
  # per handshake. Nothing about the protocol depends on the interval.
  intervalSeconds: 10
  maxServers: 4096
  maxFailures: 5
  publishIPv6: true
  # False on purpose. The rig runs on 203.0.113.0/24 (TEST-NET-3) precisely so the
  # production default is what gets exercised — Docker's own 172.17/172.18 pool is LAN
  # under IsLANIP and would force this to true.
  allowPrivatePeers: false
  persist: true
  serverMetFile: "data/server.met"
  # 5s so the file is a usable observation surface; production default is 225s.
  persistIntervalSeconds: 5

filter:
  ipfilter:
    enabled: __IPFILTER_ENABLED__
    file: "ipfilter.dat"
    minLevel: 100
    reloadMinutes: 0
  geoip:
    enabled: false
    database: "data/GeoLite2-Country.mmdb"
    blockedCountries: []
    accountID: ""
    licenseKey: ""
    updateDays: 7

# Off: the rig has no catalogue daemons, and the interop tests pin plain eD2K answers.
metaSearch:
  advertiseToLegacyClients: true
  udpMaxConcurrent: 16
  torrent:
    enabled: false
    url: "http://127.0.0.1:9701"
    token: ""
    namePrefix: "[torrent] "
    liveSearch: true
    searchTimeoutMs: 1500
    udpSearchTimeoutMs: 800
    maxResults: 50
    maxUDPResults: 10
    countInServerStatus: false
    feed:
      enabled: false
      maxRows: 250000
      reconnectMinSeconds: 5
      reconnectMaxSeconds: 300
  usenet:
    enabled: false
    url: "http://127.0.0.1:9702"
    token: ""
    namePrefix: "[usenet] "
    liveSearch: true
    searchTimeoutMs: 1500
    udpSearchTimeoutMs: 800
    maxResults: 50
    maxUDPResults: 10
    countInServerStatus: false
    feed:
      enabled: false
      maxRows: 250000
      reconnectMinSeconds: 5
      reconnectMaxSeconds: 300
  cache:
    enabled: false
    maxEntries: 1000
    maxRowsPerEntry: 100
    ttlSeconds: 600

# Client-facing Meta API (enode.meta.v1 MetaApi + AccountApi): how eMuleQt downloads
# the .torrent / .nzb behind a torrent or Usenet search row, and optionally logs in
# first. Off by default. Advertised to clients in OP_SERVERIDENT (ST_META_API 0x9E).
# See docs/meta-api.md. Off in the interop rig.
metaApi:
  enabled: false
  # Base URL sent to clients as ST_META_API. "" derives it from the advertised server
  # IP and the gRPC port (or the HTTP port when gRPC is off).
  advertiseURL: ""
  # Base URL of the HTTP endpoint as reported by GetCaps. "" derives it likewise.
  httpAdvertiseURL: ""
  # Accounts without tls send passwords in clear text. Only set this when a TLS
  # reverse proxy terminates in front of both listeners.
  allowInsecureAuth: false
  # Take client addresses (rate limits, logs) from X-Forwarded-For. Only behind a
  # reverse proxy that sets it; otherwise a client can dodge every per-IP limit.
  trustForwardedFor: false
  tls:
    certFile: ""                   # PEM; with keyFile, both listeners serve TLS
    keyFile: ""
    # Send the certificate's SPKI pin as ST_META_API_FP (0x9C), so a client can trust
    # a self-signed certificate on a bare-IP server.
    advertiseFingerprint: false
  grpc:
    enabled: true                  # gRPC + gRPC-Web; on whenever the API is
    listen: "0.0.0.0:4671"
  http:
    # Plain HTTP endpoint: Connect protocol (proto or JSON POST), GET /caps and the raw
    # GET /meta/v1/{hash}?id={catalog_id}. Off by default. When accounts are enabled
    # this listener also serves the account website (/account), even with this off.
    enabled: false
    listen: "0.0.0.0:4672"
  metafileCache:
    maxBytes: 268435456            # 256 MiB of verified metafiles, least recently used evicted
    ttlSeconds: 3600
    negativeTtlSeconds: 60         # how long "not found" / "failed verification" is remembered
  fetchTimeoutMs: 3000             # one FetchMetaFile call to a catalogue daemon
  maxMetafileBytes: 16777216       # larger metafiles are refused
  rateLimit:
    perIPPerMinute: 30             # metafile downloads per client address; 0 = unlimited
    perAccountPerMinute: 120       # per logged-in account; 0 = unlimited
  # Optional username/password login. Off = the API is public. On = a user registers
  # on this server's website first (publicURL + /account/register) and the eMule
  # client logs in with that username and password.
  accounts:
    enabled: false
    publicURL: ""                  # the website as users reach it, e.g. https://enode.example.org
    allowRegistration: true
    sessionTtlHours: 720
    minPasswordLength: 8
    pollSeconds: 300               # background check of open steps (unconfirmed payments)
    # Registration steps, in order, beyond username and password. Each has an id (in
    # URLs), a type and enabled; the rest is the type's own. No enabled step means a
    # new account is active at once. More step types and payment providers can be
    # added later without changing the others.
    steps:
      # Paid access through a WooCommerce shop: the user picks a plan, is sent to the
      # shop to pay, and the server reads the order status through the shop's REST
      # API. Needs the mysql or mongodb engine (the memory engine loses accounts).
      - id: payment
        type: payment
        enabled: false
        renewable: true            # reopen the step when the paid period ends
        # Keep re-checking a confirmed payment for this many days (hourly, or at once on
        # a webhook) and take its access back if the shop refunds or cancels it. 0 = off.
        refundWindowDays: 0
        plans:
          - id: monthly
            title: "30 days"
            periodDays: 30         # 0 = access never expires
            providerRefs:
              woocommerce: "0"     # the WooCommerce product id of this plan
        providers:
          woocommerce:
            enabled: true
            storeURL: ""           # the shop's home URL, e.g. https://shop.example.org/
            # A REST API key with read/write access (WooCommerce > Settings > Advanced >
            # REST API). Put the real values in enode.local.yaml, which is gitignored.
            consumerKey: ""
            consumerSecret: ""
            # Secret of an order.updated webhook pointed at
            # {publicURL}/account/step/payment/hook/woocommerce. "" disables it; the
            # poller still confirms every payment.
            webhookSecret: ""
            allowInsecureStore: false  # permit a plain-HTTP shop that is not on loopback
            title: "Shop checkout"
            timeoutSeconds: 15

natTraversal:
  enabled: false

ipv6:
  enabled: true
  address: ""
  # Empty when the network is v4-only. Never "auto" here, for the dynIp reason above.
  dynIp6: "__SELF_IP6__"
  publishSources: true
  probeReachability: false
  testUrls6: []

admin:
  enabled: true
  # Published to the host so the test can poll /stats.json instead of sleeping. Safe only
  # because this is a throwaway container on a private network.
  bindIP: "0.0.0.0"
  port: 4560
  # Basic-auth credentials for clients that are not on loopback (a loopback client never
  # needs them; one arriving through a reverse proxy does). Without them such a client
  # sees the status page only. Put real values in enode.local.yaml.
  username: ""
  password: ""

storage:
  engine: memory
  cleanup:
    enabled: false

debug:
  seedFixtures: false
